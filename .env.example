# TraceGuard AI Environment Configuration
# Copy this file to .env and adjust variables as required

# Core Application Settings
APP_NAME="TraceGuard AI"
ENVIRONMENT="development"  # development | production | test
SECRET_KEY="traceguard-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Default:
DATABASE_URL="sqlite:///./traceguard.db"
# Hosted / Docker PostgreSQL Example:
# DATABASE_URL="postgresql://traceguard:secure_password@localhost:5432/traceguard"

# Demo Account Credentials
DEMO_USERNAME="demo"
DEMO_PASSWORD="traceguard2024"
DEMO_EMAIL="demo@traceguard.ai"

# CORS and Network Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Limits & Safeguards
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
MAX_EVENTS_PER_SIMULATION=2000
RATE_LIMIT_PER_MINUTE=120
