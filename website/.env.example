# TraceGuard AI — Environment Configuration Example
# Copy this file to .env.local for local development or set in Cloudflare Workers environment.

# ── Public Site URL ──────────────────────────────────────────────────────────
# Used for technical SEO: sitemap generation, canonical URLs, and Open Graph previews.
# Local Development: http://localhost:5303 (Vite dev) or http://localhost:8787 (Wrangler dev)
# Production: Set to your verified custom domain or Cloudflare Workers subdomain, e.g.:
# PUBLIC_SITE_URL=https://traceguard.ai
PUBLIC_SITE_URL=http://localhost:5303

# Vite client-side equivalent (exposed to browser bundle):
VITE_PUBLIC_SITE_URL=http://localhost:5303

# ── Cloudflare Workers Runtime Bindings ──────────────────────────────────────
# Note: Static assets are bound automatically via wrangler.jsonc assets binding:
#   binding: "ASSETS"
# No API keys or database tokens are required for static website serving.
# When configuring production custom domains, attach them via:
#   wrangler deploy
# or in the Cloudflare Dashboard under Workers & Pages > traceguard-ai > Settings > Domains & Routes.
