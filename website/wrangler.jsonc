{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traceguard-ai",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
